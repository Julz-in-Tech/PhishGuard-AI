{
  "manifest_version": 3,
  "name": "PhishGuard AI - Security Sentinel",
  "version": "1.0",
  "description": "Real-time AI phishing analysis directly inside Gmail.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://mail.google.com/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*",
        "https://mail.google.com/mail/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}